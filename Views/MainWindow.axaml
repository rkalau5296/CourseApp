<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CourseApp.ViewModels"
        xmlns:m="using:CourseApp.Models"
        x:Class="CourseApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Zarządzanie Kursami"
        Width="900" Height="600">
	<Grid Margin="20" RowDefinitions="Auto,Auto,*" ColumnDefinitions="*,*" RowSpacing="10" ColumnSpacing="20">
		<TextBlock Grid.ColumnSpan="2" Text="Wybierz kurs:" FontWeight="Bold"/>
		<ComboBox Grid.Row="1" Grid.ColumnSpan="2"
                  ItemsSource="{Binding Courses}"
                  SelectedItem="{Binding SelectedCourse}"
                  HorizontalAlignment="Stretch">
			<ComboBox.ItemTemplate>
				<DataTemplate x:DataType="m:CourseNode">
					<TextBlock Text="{Binding Title}"/>
				</DataTemplate>
			</ComboBox.ItemTemplate>
		</ComboBox>

		<DockPanel Grid.Row="2" Grid.Column="0">
			<Button DockPanel.Dock="Bottom" Content="Importuj folder do zaznaczonego węzła…"
                    Click="ImportButton_Click" Margin="0,8,0,0" HorizontalAlignment="Stretch"/>
			<TextBlock DockPanel.Dock="Top" Text="Podkursy / moduły:" FontWeight="Bold" Margin="0,0,0,5"/>
			<TreeView ItemsSource="{Binding CourseChildren}"
                      SelectedItem="{Binding SelectedNode}">
				<TreeView.ItemTemplate>
					<TreeDataTemplate x:DataType="m:CourseNode" ItemsSource="{Binding Children}">
						<TextBlock Text="{Binding Title}"/>
					</TreeDataTemplate>
				</TreeView.ItemTemplate>
			</TreeView>
		</DockPanel>

		<DockPanel Grid.Row="2" Grid.Column="1">
			<TextBlock DockPanel.Dock="Top" Text="Zawartość (filmy / audio / PDF):" FontWeight="Bold" Margin="0,0,0,5"/>
			<TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Foreground="Green" TextWrapping="Wrap"/>
			<TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap"/>
			<ListBox ItemsSource="{Binding CurrentItems}"
                     SelectedItem="{Binding SelectedItem}"
                     DoubleTapped="ItemsList_DoubleTapped">
				<ListBox.ItemTemplate>
					<DataTemplate x:DataType="m:CourseItem">
						<TextBlock Text="{Binding Display}"/>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</DockPanel>
	</Grid>
</Window>
